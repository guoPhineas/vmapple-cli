diff --git a/target/arm/smccc.c b/target/arm/smccc.c
new file mode 100644
index 0000000..dc65c71
--- /dev/null
+++ b/target/arm/smccc.c
@@ -0,0 +1,41 @@
+/*
+ * Board-specific SMCCC calls handled before the TCG PSCI switch.
+ *
+ * Based on Orchard's SMCCC dispatch (Youssef Elliethy, 2026).
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "target/arm/smccc.h"
+
+static ARMSMCCCHandler smccc_handler;
+static bool (*handoff_matches)(uint64_t pc);
+static void (*handoff_apply)(ARMCPU *cpu);
+
+void arm_smccc_set_handler(ARMSMCCCHandler handler)
+{
+    smccc_handler = handler;
+}
+
+bool arm_smccc_dispatch(ARMCPU *cpu)
+{
+    return smccc_handler && smccc_handler(cpu);
+}
+
+void arm_smccc_set_handoff(bool (*matches)(uint64_t pc),
+                           void (*apply)(ARMCPU *cpu))
+{
+    handoff_matches = matches;
+    handoff_apply = apply;
+}
+
+bool arm_smccc_handoff_pc(uint64_t pc)
+{
+    return handoff_matches && handoff_matches(pc);
+}
+
+void arm_smccc_handoff(ARMCPU *cpu)
+{
+    if (handoff_apply) {
+        handoff_apply(cpu);
+    }
+}
