diff --git a/hw/vmapple/hvc.c b/hw/vmapple/hvc.c
new file mode 100644
index 0000000..1e1847e
--- /dev/null
+++ b/hw/vmapple/hvc.c
@@ -0,0 +1,159 @@
+/*
+ * VMApple CPU-service calls under TCG.
+ *
+ * PAC key inheritance and default PIDs follow the mechanism described in
+ * Orchard's hw/vmapple/hvc.c (Youssef Elliethy, 2026). The per-process key
+ * switching calls are acknowledged without changing the architected keys.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/guest-random.h"
+#include "qemu/bswap.h"
+#include "qemu/units.h"
+#include "qemu/main-loop.h"
+#include "hw/core/cpu.h"
+#include "hw/vmapple/hvc.h"
+#include "exec/memattrs.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "target/arm/cpu.h"
+#include "target/arm/smccc.h"
+
+#define VMAPPLE_CPU_SERVICE_BASE UINT64_C(0xc1000000)
+
+static struct {
+    bool valid;
+    ARMPACKey apia, apib, apda, apdb, apga;
+} boot_keys;
+
+static uint64_t default_pids[2];
+static uint64_t handoff_pcs[4];
+static unsigned handoff_pc_count;
+static bool handoff_done;
+
+static void vmapple_handoff_load_pcs(void)
+{
+    const char *list = g_getenv("QEMU_VMAPPLE_HANDOFF_PC");
+    char **items = list ? g_strsplit(list, ",", -1) : NULL;
+
+    handoff_pc_count = 0;
+    for (unsigned i = 0; items && items[i] && i < 4; i++) {
+        uint64_t pc = g_ascii_strtoull(items[i], NULL, 0);
+        if (pc) {
+            handoff_pcs[handoff_pc_count++] = pc;
+        }
+    }
+    g_strfreev(items);
+    if (!handoff_pc_count) {
+        handoff_pcs[handoff_pc_count++] = UINT64_C(0xaca00000);
+    }
+}
+
+static bool vmapple_handoff_matches(uint64_t pc)
+{
+    for (unsigned i = 0; i < handoff_pc_count; i++) {
+        if (pc == handoff_pcs[i]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void vmapple_handoff(ARMCPU *cpu)
+{
+    BQL_LOCK_GUARD();
+    CPUARMState *env = &cpu->env;
+    const char *args = g_getenv("QEMU_VMAPPLE_BOOT_ARGS");
+    uint64_t boot = env->xregs[1];
+    uint8_t info[112];
+    char payload[608] = { 0 };
+
+    if (handoff_done || CPU(cpu) != first_cpu || !boot ||
+        address_space_read(&address_space_memory, boot,
+                           MEMTXATTRS_UNSPECIFIED, info, sizeof(info)) != MEMTX_OK) {
+        return;
+    }
+    if (lduw_le_p(info) < 2 || lduw_le_p(info) > 3 ||
+        lduw_le_p(info + 2) != 2 ||
+        ldq_le_p(info + 96) < ldq_le_p(info + 8) ||
+        ldl_le_p(info + 104) == 0 || ldl_le_p(info + 104) > 4 * MiB) {
+        return;
+    }
+    g_strlcpy(payload, args ? args : "-v serial=11 debug=0x14c",
+              sizeof(payload));
+    if (address_space_write(&address_space_memory, boot + 108,
+                            MEMTXATTRS_UNSPECIFIED, payload,
+                            sizeof(payload)) != MEMTX_OK) {
+        error_report("vmapple TCG handoff: cannot write boot arguments");
+        return;
+    }
+    handoff_done = true;
+    info_report("vmapple TCG handoff: boot arguments set at 0x%" PRIx64,
+                boot + 108);
+}
+
+static bool vmapple_hvc(ARMCPU *cpu)
+{
+    BQL_LOCK_GUARD();
+    CPUARMState *env = &cpu->env;
+    uint64_t fid = env->xregs[0];
+
+    if (fid < VMAPPLE_CPU_SERVICE_BASE ||
+        fid >= VMAPPLE_CPU_SERVICE_BASE + 16) {
+        return false;
+    }
+
+    switch (fid - VMAPPLE_CPU_SERVICE_BASE) {
+    case 0: /* VMAPPLE_PAC_SET_INITIAL_STATE */
+        if (CPU(cpu) == first_cpu) {
+            boot_keys.apia = env->keys.apia;
+            boot_keys.apib = env->keys.apib;
+            boot_keys.apda = env->keys.apda;
+            boot_keys.apdb = env->keys.apdb;
+            boot_keys.apga = env->keys.apga;
+            boot_keys.valid = true;
+        } else if (boot_keys.valid) {
+            env->keys.apia = boot_keys.apia;
+            env->keys.apib = boot_keys.apib;
+            env->keys.apda = boot_keys.apda;
+            env->keys.apdb = boot_keys.apdb;
+            env->keys.apga = boot_keys.apga;
+        } else {
+            error_report("VMApple CPU_INITIALIZE cpu=%d before boot PAC context",
+                         CPU(cpu)->cpu_index);
+            env->xregs[0] = UINT64_MAX;
+            return true;
+        }
+        break;
+    case 1: /* VMAPPLE_PAC_GET_DEFAULT_KEYS */
+        env->xregs[2] = default_pids[0];
+        env->xregs[3] = default_pids[1];
+        break;
+    default:
+        /* Architected EL0 and EL1 PAC keys remain shared across tasks. */
+        break;
+    }
+
+    env->xregs[0] = 0;
+    return true;
+}
+
+void vmapple_hvc_reset(void)
+{
+    boot_keys.valid = false;
+    handoff_done = false;
+    do {
+        qemu_guest_getrandom_nofail(default_pids, sizeof(default_pids));
+    } while (!default_pids[0] || !default_pids[1]);
+}
+
+void vmapple_hvc_init(void)
+{
+    arm_smccc_set_handler(vmapple_hvc);
+    if (g_getenv("QEMU_VMAPPLE_HANDOFF")) {
+        vmapple_handoff_load_pcs();
+        arm_smccc_set_handoff(vmapple_handoff_matches, vmapple_handoff);
+    }
+    vmapple_hvc_reset();
+}
